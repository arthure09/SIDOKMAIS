# Contoh isi .env. Sejak pemisahan mode, di mesin kerja ada DUA file nyata:
#   .env.dummy  — PostgreSQL lokal, jalan di mana saja (tanpa WiFi RS)
#   .env.simrs  — replika SIMRS, HANYA jalan di jaringan RS
# `.env` sendiri cuma salinan aktif dari salah satunya. Jangan diedit langsung:
#   npm run dev:dummy   (di luar RS)
#   npm run dev:simrs   (di dalam RS)
# Ketiganya di-gitignore; hanya file .env.example ini yang masuk repo.

DATABASE_URL=

# WAJIB diisi nilai acak minimal 32 karakter — server menolak start kalau
# kosong, terlalu pendek, atau masih berisi placeholder. Generate dengan:
#   openssl rand -base64 48
# Jangan pernah commit nilai aslinya; file ini cuma contoh.
JWT_SECRET=""

JWT_EXPIRES_IN="1d"
PORT=3000

# --- Sumber data ---
# "simrs" = replika MySQL SIMRS RS Dharmais, DATA PASIEN ASLI. Mode yang
#           berlaku sejak 24 Ags 2026 (izin datasource sudah diberikan).
# "dummy" = PostgreSQL lokal berisi data seed. Dipakai test suite.
#
# Yang ikut pindah ke SIMRS: Pasien, Kunjungan, Operasi, Konsultasi, Dashboard,
# Jasa Medis, Lab, Radiologi.
# Yang SELALU di PostgreSQL, apa pun nilainya: Notifikasi, Kalender, AuditLog,
# Pengguna — SIMRS memang tidak menyimpannya.
#
# Catatan akun: di mode "simrs" hanya akun dokter yang NIP-nya dikenal SIMRS
# yang bisa melihat data (lihat prisma/seed-dokter-simrs.js). Akun dokter hasil
# seed dummy akan menerima 403 — itu perilaku yang benar, bukan bug.
SUMBER_DATA="simrs"

# Hanya dipakai kalau SUMBER_DATA="simrs". Akunnya WAJIB read-only
# (GRANT SELECT saja) — aplikasi tidak pernah menulis ke SIMRS.
SIMRS_HOST=""
SIMRS_PORT=3306
SIMRS_USER=""
SIMRS_PASSWORD=""
SIMRS_POOL_LIMIT=5
