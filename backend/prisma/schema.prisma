generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOKTER
  ADMIN
}

enum JenisKelamin {
  L
  P
}

// Kategori kunjungan (Rawat Jalan/IGD/Rawat Inap) diturunkan dari sini —
// lihat src/utils/jenisKunjungan.js. IGD masuk 18 Ags 2026 (Tahap 1
// docs/rencana-revisi-modul-dokter.md); OK bukan kategori kunjungan, cuma
// dipakai Operasi.
enum RuanganJenis {
  POLI
  OK
  RAWAT_INAP
  IGD
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
}

enum StatusKunjungan {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum NotifikasiTipe {
  PASIEN_BARU
  REMINDER_OPERASI
  PERUBAHAN_JADWAL
  HASIL_LAB
}

enum OperasiStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Klasifikasi laporan operasi. Terpisah dari OperasiStatus: yang ini sifat
// tindakannya (direncanakan vs darurat), bukan progres jadwalnya.
enum SifatOperasi {
  ELEKTIF
  CITO
}

// Kelas luka operasi (standar surgical wound classification).
enum JenisPembedahan {
  BERSIH
  BERSIH_TERKONTAMINASI
  KONTAMINASI
  KOTOR
}

enum StatusPemeriksaanLab {
  PENDING
  COMPLETED
  CANCELLED
}

enum FlagHasilLab {
  RENDAH
  NORMAL
  TINGGI
  ABNORMAL
}

enum TipeCatatanKalender {
  REMINDER
  BLOCKING
  PRIBADI
}

// Dimensi terpisah dari jenis kunjungan: konsul CITO bisa datang dari rawat
// jalan maupun rawat inap.
enum PrioritasKonsultasi {
  BIASA
  CITO
}

enum StatusKonsultasi {
  MENUNGGU_JAWABAN
  SUDAH_DIJAWAB
}

model Dokter {
  id           String   @id @default(uuid())
  nip          String   @unique
  nama         String
  spesialisasi String?
  sip          String?
  statusAktif  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  penggunaAkun    Pengguna?
  assignments     DokterPasienAssignment[]
  kunjungan       Kunjungan[]
  notifikasi      Notifikasi[]
  pemeriksaanLab  PemeriksaanLab[]
  catatanKalender CatatanKalender[]
  pendapatan      Pendapatan[]

  konsultasiDiajukan  Konsultasi[] @relation("KonsultasiPengirim")
  konsultasiDitujukan Konsultasi[] @relation("KonsultasiTujuan")
}

model Pasien {
  id            String       @id @default(uuid())
  norm          String       @unique
  nama          String
  jenisKelamin  JenisKelamin
  tanggalLahir  DateTime?
  tempatLahir   String?
  alamat        String?
  golonganDarah String?
  // PENDING: format final No. RM (relasi dengan `norm`) belum diputuskan bersama
  // supervisor — lihat catatan "format data klinis (ICD-10, No. RM)" di CLAUDE.md.
  noRekamMedis  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  assignments    DokterPasienAssignment[]
  kunjungan      Kunjungan[]
  pemeriksaanLab PemeriksaanLab[]
  konsultasi     Konsultasi[]
  pendapatan     Pendapatan[]
}

model Ruangan {
  id     String       @id @default(uuid())
  nama   String
  jenis  RuanganJenis
  lantai Int?

  kunjungan Kunjungan[]
  operasi   Operasi[]
}

model DokterPasienAssignment {
  id            String           @id @default(uuid())
  dokterId      String
  pasienId      String
  tanggalAssign DateTime         @default(now())
  status        AssignmentStatus @default(ACTIVE)

  dokter Dokter @relation(fields: [dokterId], references: [id], onDelete: Cascade)
  pasien Pasien @relation(fields: [pasienId], references: [id], onDelete: Cascade)

  @@index([dokterId])
  @@index([pasienId])
}

model Kunjungan {
  id              String          @id @default(uuid())
  pasienId        String
  dokterId        String
  ruanganId       String
  tanggalMasuk    DateTime
  tanggalKeluar   DateTime?
  diagnosa        String?
  statusKunjungan StatusKunjungan @default(SCHEDULED)
  isPasienBaru    Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  pasien  Pasien  @relation(fields: [pasienId], references: [id], onDelete: Restrict)
  dokter  Dokter  @relation(fields: [dokterId], references: [id], onDelete: Restrict)
  ruangan Ruangan @relation(fields: [ruanganId], references: [id], onDelete: Restrict)

  operasi        Operasi[]
  pemeriksaanLab PemeriksaanLab[]
  konsultasi     Konsultasi[]
}

model Pengguna {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  dokterId     String?  @unique
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dokter Dokter? @relation(fields: [dokterId], references: [id], onDelete: SetNull)
}

model Notifikasi {
  id          String         @id @default(uuid())
  dokterId    String
  tipe        NotifikasiTipe
  pesan       String
  isRead      Boolean        @default(false)
  relatedId   String?
  relatedType String?
  createdAt   DateTime       @default(now())

  dokter Dokter @relation(fields: [dokterId], references: [id], onDelete: Cascade)
}

// PENDING: struktur real belum tersedia dari RS — kolom di bawah disederhanakan
// dari referensi format export SIMRS, isi & relasi lanjutan bisa berubah.
model Operasi {
  id             String        @id @default(uuid())
  kunjunganId    String
  ruanganId      String
  tanggalOperasi DateTime
  jenisTindakan  String
  tim            String[]
  status         OperasiStatus @default(SCHEDULED)
  catatanPreOp   String?
  catatanPostOp  String?

  // --- Laporan operasi (Tahap 3 docs/rencana-revisi-modul-dokter.md) ---
  // Semua nullable: baru terisi setelah tindakan selesai, dan record lama tetap
  // valid tanpa ini. Endpoint detail hanya mengirimkannya saat status efektif
  // COMPLETED — lihat src/utils/laporanOperasi.js.
  //
  // `tim` di atas tetap dipakai untuk kartu jadwal (daftar nama tanpa peran);
  // field bernama peran di bawah ini yang dipakai laporan.
  dokterOperator        String?
  asistenOperator       String?
  perawatInstrumentator String?
  perawatSirkuler       String?
  dokterAnestesi        String?
  jenisAnestesi         String?
  kategoriOperasi       String?

  diagnosaPraBedah   String?
  diagnosaPascaBedah String?

  jamMulaiInsisi DateTime?
  jamSelesai     DateTime?

  sifatOperasi          SifatOperasi?
  jenisPembedahan       JenisPembedahan?
  antibiotikProfilaksis Boolean?

  // Hanya terisi kalau jenis anestesinya lokal.
  teknikAnestesiLokal     String?
  lokasiAnestesi          String?
  obatAnestesi            String?
  responHipersensitivitas String?
  kejadianToksikasi       String?

  tindakanDilakukan String?
  deskripsiOperasi  String?

  komplikasi             String?
  jumlahKehilanganDarah  Int?
  transfusi              String?
  spesimen               String?
  pemasanganImplan       String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  kunjungan Kunjungan @relation(fields: [kunjunganId], references: [id], onDelete: Restrict)
  ruangan   Ruangan   @relation(fields: [ruanganId], references: [id], onDelete: Restrict)
}

model Penjamin {
  id   String @id @default(uuid())
  nama String
  tipe String
  // Pengelompokan utama laporan jasa medis: JKN vs Non-JKN. Flag eksplisit,
  // bukan diturunkan dari string `tipe` — mencocokkan teks bebas buat menentukan
  // kelompok uang itu cara yang diam-diam salah begitu ada penjamin baru.
  isJkn Boolean @default(false)

  pendapatan Pendapatan[]
}

// Satu baris jasa medis per pelayanan — Tahap 4 docs/rencana-revisi-modul-dokter.md.
//
// Bentuknya mengikuti tabel "Detail Tindakan" SIREMDIS (screenshot referensi,
// 19 Ags 2026): NORM, nama pasien, nama tindakan, tanggal tindakan, jasa, unit
// pelayanan, penjamin.
//
// Catatan riwayat keputusan: versi pertama modul ini sengaja TIDAK punya relasi
// ke Pasien (keputusan Arthuro 14 Ags 2026 — dokter cukup tahu pelayanan mana,
// bukan siapa pasiennya). Dibatalkan 19 Ags 2026 setelah bentuk asli SIREMDIS
// terlihat: dua kolom identitas pasien memang ada di laporan aslinya.
//
// `unitPelayanan` = SMF/unit tempat pelayanan terjadi, BUKAN spesialisasi
// dokternya — di referensi, dokter Sp.THT menagih konsul di unit "Anak".
//
// Ringkasan periode (total JKN / Non-JKN / bruto) TIDAK disimpan sebagai model
// sendiri — itu agregasi atas rentang tanggal yang dipilih user, jadi dihitung
// saat diminta. Menyimpannya berarti punya dua sumber angka yang bisa berbeda.
//
// isDummy wajib true selama fase dummy (CLAUDE.md aturan #3).
model Pendapatan {
  id         String @id @default(uuid())
  dokterId   String
  pasienId   String
  penjaminId String

  namaTindakan    String
  tanggalTindakan DateTime
  jasa            Decimal  @db.Decimal(14, 2)
  unitPelayanan   String

  isDummy   Boolean  @default(true)
  createdAt DateTime @default(now())

  dokter   Dokter   @relation(fields: [dokterId], references: [id], onDelete: Cascade)
  pasien   Pasien   @relation(fields: [pasienId], references: [id], onDelete: Restrict)
  penjamin Penjamin @relation(fields: [penjaminId], references: [id], onDelete: Restrict)

  // Query utamanya "jasa medis saya dalam rentang tanggal ini".
  @@index([dokterId, tanggalTindakan])
}

// Surat konsul antar-dokter (Lembar Konsultasi SIMRS), BUKAN jadwal appointment.
// Satu dokter meminta pendapat dokter lain soal satu pasien; dua pihak
// (pengirim, tujuan) dan dua state (menunggu jawaban, sudah dijawab).
//
// Hak akses dokter ditentukan lewat `dokterTujuanId` yang tercatat di record
// ini — BEDA pola dari modul lab/pasien yang lewat DokterPasienAssignment.
// Dokter yang login hanya melihat konsul yang DITUJUKAN kepadanya, bukan yang
// dia ajukan (keputusan terkunci, docs/rencana-revisi-modul-dokter.md Tahap 2).
//
// `dokterPengirimId` tidak ada di tabel field rencana, tapi wajib ada: satu
// lembar konsul selalu punya dokter peminta, dan tanpa itu layar detail tidak
// bisa menampilkan konsul ini datang dari siapa.
model Konsultasi {
  id                String              @id @default(uuid())
  pasienId          String
  kunjunganId       String?
  dokterPengirimId  String
  dokterTujuanId    String
  prioritas         PrioritasKonsultasi @default(BIASA)
  status            StatusKonsultasi    @default(MENUNGGU_JAWABAN)
  tanggalPermintaan DateTime            @default(now())
  diagnosisKerja    String

  // Ikhtisar klinis — semua opsional: lembar konsul di lapangan sering terisi
  // sebagian. `tekananDarah` String karena bentuknya "120/80", bukan satu angka.
  kesadaran    String?
  tekananDarah String?
  nadi         Int?
  pernapasan   Int?
  suhu         Float?
  tinggiBadan  Int?
  beratBadan   Float?
  nyeri        Int?

  konsulYangDiminta String

  // Bagian jawaban — kosong selama status MENUNGGU_JAWABAN.
  penemuan         String?
  diagnosisJawaban String?
  anjuran          String?
  setujuUntuk      String?
  tanggalJawaban   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pasien         Pasien     @relation(fields: [pasienId], references: [id], onDelete: Restrict)
  kunjungan      Kunjungan? @relation(fields: [kunjunganId], references: [id], onDelete: SetNull)
  dokterPengirim Dokter     @relation("KonsultasiPengirim", fields: [dokterPengirimId], references: [id], onDelete: Restrict)
  dokterTujuan   Dokter     @relation("KonsultasiTujuan", fields: [dokterTujuanId], references: [id], onDelete: Restrict)

  // Query utamanya "konsul untuk saya, terbaru dulu".
  @@index([dokterTujuanId, tanggalPermintaan])
  @@index([pasienId])
}

// Satu order/permintaan lab. `kunjunganId` nullable (lab rawat inap/order susulan
// di luar konteks kunjungan poli). Hak akses dokter ditentukan lewat
// DokterPasienAssignment (pola pasien.routes.js), BUKAN dokterPemintaId — dokter
// lain tetap perlu bisa lihat riwayat lab pasien yang di-assign kepadanya.
model PemeriksaanLab {
  id                String               @id @default(uuid())
  pasienId          String
  kunjunganId       String?
  dokterPemintaId   String?
  kategori          String
  namaPemeriksaan   String
  laboratorium      String?
  tanggalPermintaan DateTime
  tanggalHasil      DateTime?
  status            StatusPemeriksaanLab
  catatan           String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  pasien        Pasien     @relation(fields: [pasienId], references: [id], onDelete: Restrict)
  kunjungan     Kunjungan? @relation(fields: [kunjunganId], references: [id], onDelete: SetNull)
  dokterPeminta Dokter?    @relation(fields: [dokterPemintaId], references: [id], onDelete: SetNull)

  hasilLabItem HasilLabItem[]

  @@index([pasienId])
  @@index([kunjunganId])
  @@index([tanggalPermintaan])
  @@index([pasienId, tanggalPermintaan])
}

// Satu parameter/analit dalam satu PemeriksaanLab. `nilai`/`nilaiRujukan` String
// (bukan Decimal) karena banyak hasil lab kualitatif ("Reaktif", "3+", dst).
model HasilLabItem {
  id               String       @id @default(uuid())
  pemeriksaanLabId String
  namaParameter    String
  nilai            String
  satuan           String?
  nilaiRujukan     String?
  flag             FlagHasilLab
  urutan           Int?

  pemeriksaanLab PemeriksaanLab @relation(fields: [pemeriksaanLabId], references: [id], onDelete: Cascade)

  @@index([pemeriksaanLabId])
}

// Kalender pribadi dokter — murni milik dokter yang membuatnya, tidak ada
// relasi ke Pasien/Kunjungan/Operasi sama sekali (read-only modul lain tetap
// tidak berubah). `waktu` sengaja String "HH:mm" polos, bukan DateTime —
// ini jam dinding pengingat, bukan instant yang perlu ikut konversi
// WIB_OFFSET_MS seperti `tanggal` (lihat kalender.routes.js).
model CatatanKalender {
  id        String              @id @default(uuid())
  dokterId  String
  tanggal   DateTime
  waktu     String?
  judul     String
  catatan   String?
  tipe      TipeCatatanKalender
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  dokter Dokter @relation(fields: [dokterId], references: [id], onDelete: Cascade)

  @@index([dokterId])
  @@index([tanggal])
}

// Audit generik wajib untuk semua write action manual/chatbot (CLAUDE.md aturan #4).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())
}
